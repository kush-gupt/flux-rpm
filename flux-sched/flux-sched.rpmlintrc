# These filters apply to built RPMs. When running rpmlint on only the spec file,
# they won't match anything. Set badness to 0 so unused filters don't count as
# errors during spec-only linting.
setBadness('unused-rpmlintrc-filter', 0)

# Domain-specific terms used in Flux scheduler
addFilter("spelling-error.*(fluxion|qmanager)")

# Internal libraries without standard soname - upstream build system issue
addFilter("invalid-soname.*libsched-fluxion")
